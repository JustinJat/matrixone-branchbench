# MC Simulation workflow — MatrixOne, mini scale.
# Flat star shape; reduced fanout to stay friendly on the shared free-tier.
run_id: "macro_simulation_mo"
backend: MATRIXONE
workflow: SIMULATION

database_setup {
    db_name: "macro_sim_mo"
    cleanup: true
    sql_dump {
        sql_dump_path: "db_setup/ch_benchmark_seed_mo.sql"
    }
}

setup {
    workers: 15             # T  (full: 1000)
    total_steps: 1          # S
    root_fanout: 15         # F_r (full: 1000)
    max_depth: 1            # D
    cross_branch_queries: 1 # C
    db_scale: 1
}

step {
    schema_changes: 0   # M_s
    data_mutations: 50  # M_d
    eval_queries: 1     # Q_v
    prune_prob: 1.0     # gamma
}

autocommit: true
