# MCTS workflow — MatrixOne, mini scale.
run_id: "macro_mcts_mo"
backend: MATRIXONE
workflow: MCTS

database_setup {
    db_name: "macro_mcts_mo"
    cleanup: true
    sql_dump {
        sql_dump_path: "db_setup/ch_benchmark_seed_mo.sql"
    }
}

setup {
    workers: 3              # T
    total_steps: 8          # S
    root_fanout: 5          # F_r
    inner_fanout: 3         # F_i
    max_depth: 5            # D
    cross_branch_queries: 0 # C
    db_scale: 1
}

step {
    schema_changes: 0   # M_s
    data_mutations: 1   # M_d
    eval_queries: 1     # Q_v
    prune_prob: 0.1     # gamma
}

autocommit: true
