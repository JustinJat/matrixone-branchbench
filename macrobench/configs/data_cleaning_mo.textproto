# Data Cleaning workflow — MatrixOne, mini scale.
run_id: "macro_data_cleaning_mo"
backend: MATRIXONE
workflow: DATA_CLEANING

database_setup {
    db_name: "macro_dataclean_mo"
    cleanup: true
    sql_dump {
        sql_dump_path: "db_setup/ch_benchmark_seed_mo.sql"
    }
}

setup {
    workers: 3              # T
    total_steps: 6          # S
    root_fanout: 3          # F_r
    inner_fanout: 2         # F_i
    max_depth: 3            # D
    cross_branch_queries: 1 # C
    db_scale: 1
}

step {
    schema_changes: 1   # M_s
    data_mutations: 1   # M_d
    eval_queries: 1     # Q_v
    prune_prob: 0.0     # gamma
}

autocommit: true
