# Software Development workflow — MatrixOne, mini scale.
run_id: "macro_software_dev_mo"
backend: MATRIXONE
workflow: SOFTWARE_DEV

database_setup {
    db_name: "macro_softdev_mo"
    cleanup: true
    sql_dump {
        sql_dump_path: "db_setup/ch_benchmark_seed_mo.sql"
    }
}

setup {
    workers: 2              # T
    total_steps: 5          # S
    root_fanout: 3          # F_r
    inner_fanout: 2         # F_i
    max_depth: 3            # D
    cross_branch_queries: 1 # C
    db_scale: 1
}

step {
    schema_changes: 2   # M_s
    data_mutations: 1   # M_d
    eval_queries: 2     # Q_v
    prune_prob: 0.1     # gamma
}

autocommit: true
